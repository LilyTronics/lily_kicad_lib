<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 7.1-c000 79.cb7c5a1, 2022/04/14-05:22:35        ">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:xmp="http://ns.adobe.com/xap/1.0/"
            xmlns:dc="http://purl.org/dc/elements/1.1/"
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/"
            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/">
         <xmp:CreatorTool>BroadVision, Inc.</xmp:CreatorTool>
         <xmp:ModifyDate>2022-09-13T10:16:53-07:00</xmp:ModifyDate>
         <xmp:CreateDate>2022-09-12T11:48:08-07:00</xmp:CreateDate>
         <xmp:MetadataDate>2022-09-13T10:16:53-07:00</xmp:MetadataDate>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MOC3023M - 6-Pin DIP Random-Phase Triac Driver Output Optocoupler (250/400 V Peak)</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The MOC301XM and MOC302XM series are optically isolated&#xA;triac driver devices. These devices contain a GaAs infrared emitting&#xA;diode and a light activated silicon bilateral switch, which functions&#xA;like a triac. They are designed for interfacing between electronic&#xA;controls and power triacs to control resistive and inductive loads for&#xA;115 VAC operations.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <pdf:Producer>Acrobat Distiller 22.0 (Windows)</pdf:Producer>
         <pdf:Keywords/>
         <xmpMM:DocumentID>uuid:419b99e3-2ce5-44a0-b912-a41d5e18ba43</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:5c7c559a-ad8c-4a67-812f-72fc27db7851</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
